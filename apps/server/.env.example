# .env.development and .env.production
# ── AI (Mistral, primary provider) ────────────────────────────────────────────
MISTRAL_API_KEY=

# Optional — defaults to mistral-small-latest
MISTRAL_MODEL=

# Optional — local rate limit caps, tune to your Mistral plan
MISTRAL_REQUESTS_PER_MINUTE=
MISTRAL_TOKENS_PER_MINUTE=
MISTRAL_MAX_CONCURRENT=

# ── AI (Groq, fallback provider) ─────────────────────────────────────────────
GROQ_API_KEY=

# Optional — defaults to qwen/qwen3.6-27b
GROQ_MODEL=

# Optional — local rate limit caps, tune to your Groq plan
GROQ_REQUESTS_PER_MINUTE=
GROQ_TOKENS_PER_MINUTE=
GROQ_MAX_CONCURRENT=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5005
CLIENT_URL=

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
COOKIE_SECRET=

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=