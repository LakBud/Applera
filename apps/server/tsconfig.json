{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "resolveJsonModule": true,

    "verbatimModuleSyntax": true,

    "types": ["node", "express"],

    "paths": {
      "@/*": ["./src/*"],
      "@repo/schemas": ["../../packages/schemas/src/index.ts"]
    }
  },

  "include": ["src"],

  "exclude": ["node_modules", "dist"]
}
