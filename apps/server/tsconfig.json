{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,

    "types": ["node"],

    "noEmit": true
  },
  "include": ["src"]
}
