{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "declaration": true,
    "declarationMap": true,

    "emitDeclarationOnly": false,
    "noEmit": false,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "skipLibCheck": true,

    "verbatimModuleSyntax": true,

    "composite": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
