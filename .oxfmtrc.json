{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "importOrder": ["^react(.*)$", "^@?\\w", "^@/components/(.*)$", "^@/utils/(.*)$", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderCaseInsensitive": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "apps/client/dist",
    "apps/server/dist",
    "pnpm-lock.yaml",
    "apps/client/dist",
    "apps/server/dist"
  ]
}
